<UserControl
    x:Class="MateralMergeBlockVSIX.ToolWindows.SolutionOpenedControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
    xmlns:viewModels="clr-namespace:MateralMergeBlockVSIX.ToolWindows.ViewModels"
    toolkit:Themes.UseVsTheme="True"
    mc:Ignorable="d">
    <UserControl.DataContext>
        <viewModels:SolutionOpenedViewModel x:Name="ViewModel" />
    </UserControl.DataContext>
    <StackPanel>
        <TextBlock
            Margin="0,15,0,10"
            HorizontalAlignment="Stretch"
            FontWeight="Bold"
            Text="{Binding SolutionName, Mode=OneWay}"
            TextAlignment="Center" />
        <StackPanel Margin="5" Visibility="{Binding Visibility, Mode=OneWay}">
            <Button
                Margin="0,0,0,5"
                Content="生成代码"
                Click="GeneratorCodeButton_Click" />
        </StackPanel>
        <Grid Margin="5" Visibility="{Binding Visibility, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock FontWeight="Bold" Text="其他模块" />
            <ScrollViewer
                Grid.Row="1"
                Height="200"
                Margin="5">
                <ItemsControl ItemsSource="{Binding Modules, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Margin="0,0,5,0" Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="viewModels:ModuleViewModel">
                            <Grid Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Text="{Binding ModuleName}"
                                    TextAlignment="Right" />
                                <Button
                                    Grid.Column="1"
                                    Margin="5,0,0,0"
                                    Content="打开"
                                    Click="OpenModuleSolution_Click"
                                    DataContext="{Binding}" />
                                <Button
                                    Grid.Column="2"
                                    Margin="5,0,0,0"
                                    Content="构建"
                                    Click="BuildModuleSolution_Click"
                                    DataContext="{Binding}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        <StackPanel Margin="5" Visibility="{Binding Visibility, Mode=OneWay}">
            <TextBlock
                Margin="0,0,0,5"
                FontWeight="Bold"
                Text="创建新模块" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="ModuleName"
                    Grid.Column="0"
                    Text="NewModule" />
                <Button
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    Content="创建"
                    Click="CreateNewModuleButton_Click" />
            </Grid>
        </StackPanel>
        <StackPanel Margin="5" Visibility="{Binding Visibility, Mode=OneWay}">
            <TextBlock
                Margin="0,0,0,5"
                FontWeight="Bold"
                Text="项目功能" />
            <Button
                Margin="0,0,0,5"
                Content="构建所有"
                Click="BuildAllButton_Click" />
        </StackPanel>
    </StackPanel>
</UserControl>
